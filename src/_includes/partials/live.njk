{%- set months = { en: ["JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"], pt: ["JAN","FEV","MAR","ABR","MAI","JUN","JUL","AGO","SET","OUT","NOV","DEZ"] } -%}
<section class="section live" id="live" aria-labelledby="live-title" data-live>
  <div class="container">
    <header class="section-head" data-reveal>
      <h2 class="section-title" id="live-title">{{ s.live.title }}</h2>
      <p class="section-sub">{{ s.live.subtitle }}</p>
    </header>
    <div class="board" data-reveal>
      <div class="board__bar">
        <h3>{{ s.live.board | upper }}</h3>
        <span class="board__clock">{{ s.live.localTime | upper }} <b data-clock>00:00</b></span>
      </div>
      <div class="board__head" aria-hidden="true">
        <span>{{ s.live.date | upper }}</span><span>{{ s.live.destination | upper }}</span><span>{{ s.live.venue | upper }}</span><span>{{ s.live.status | upper }}</span><span></span>
      </div>
      <ul class="board__rows">
        {% for show in live.shows %}
        {%- set parts = show.date.split("-") -%}
        {%- set dateText = parts[2] + " " + months[lang][(parts[1] | int) - 1] -%}
        <li class="board__row is-{{ show.status }}">
          <span class="flaps flaps--date" aria-label="{{ dateText }}">{% for c in dateText | chars(6) %}<span class="flap" data-char="{{ c }}">{{ c }}</span>{% endfor %}</span>
          <span class="flaps flaps--city" aria-label="{{ show.city }}">{% for c in show.city | chars(15) %}<span class="flap" data-char="{{ c }}">{{ c }}</span>{% endfor %}</span>
          <span class="flaps flaps--venue" aria-label="{{ show.venue }}">{% for c in show.venue | chars(14) %}<span class="flap" data-char="{{ c }}">{{ c }}</span>{% endfor %}</span>
          <span class="flaps flaps--status" aria-label="{{ s.live['status_' + show.status] }}">{% for c in s.live['status_' + show.status] | chars(9) %}<span class="flap" data-char="{{ c }}">{{ c }}</span>{% endfor %}</span>
          {% if show.status == "onsale" and show.ticketsUrl %}
          <a class="btn btn--primary btn--sm" href="{{ show.ticketsUrl }}" target="_blank" rel="noopener">{{ s.live.tickets }}</a>
          {% else %}
          <span class="btn btn--ghost btn--sm is-disabled" aria-disabled="true">{{ s.live['status_' + show.status] }}</span>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
    <div class="live__foot" data-reveal>
      <a class="text-link" href="#">{{ s.live.past }}</a>
      <p>{{ s.live.ask }} <a class="btn btn--ghost" href="{{ anchorBase }}#booking">{{ s.live.booking }}</a></p>
    </div>
  </div>
</section>
