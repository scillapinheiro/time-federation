{%- from "partials/macros.njk" import icon -%}
{%- set b = s.booking -%}
<section class="section booking booking--form" id="booking" aria-labelledby="booking-title">
  <div class="planet" aria-hidden="true"></div>
  <div class="container booking__content">
    <h2 class="section-title" id="booking-title">{{ b.title }}</h2>
    <p class="booking__lead booking__lead--sm">{{ b.formLead }}</p>
    <form class="form" name="booking" method="POST" action="/{{ lang }}/booking/thanks/" data-netlify="true" netlify-honeypot="company-website">
      <input type="hidden" name="form-name" value="booking">
      <input type="hidden" name="language" value="{{ lang }}">
      <p class="sr-only"><label>Website <input name="company-website" tabindex="-1" autocomplete="off"></label></p>
      <div class="form__grid">
        <label class="field"><span>{{ b.name | upper }} *</span><input name="name" required autocomplete="name" placeholder="{{ b.namePh }}"></label>
        <label class="field"><span>{{ b.email | upper }} *</span><input name="email" type="email" required autocomplete="email" placeholder="{{ b.emailPh }}"></label>
        <label class="field"><span>{{ b.phone | upper }}</span><input name="phone" type="tel" autocomplete="tel" placeholder="{{ b.phonePh }}"></label>
        <label class="field"><span>{{ b.date | upper }} *</span><input name="event-date" type="date" required></label>
        <label class="field"><span>{{ b.city | upper }} *</span><input name="city" required placeholder="{{ b.cityPh }}"></label>
        <label class="field field--select"><span>{{ b.type | upper }}</span>
          <select name="event-type"><option value="">{{ b.typePh }}</option>{% for o in b.typeOptions %}<option>{{ o }}</option>{% endfor %}</select>
        </label>
        <label class="field field--full"><span>{{ b.message | upper }}</span><textarea name="message" rows="4" placeholder="{{ b.messagePh }}"></textarea></label>
      </div>
      <div class="form__actions">
        <button class="btn btn--primary" type="submit">{{ b.send }}</button>
        <a class="text-link text-link--icon" href="/{{ lang }}/#booking">{{ icon("i-whatsapp", "btn__svg") }} {{ b.toWhatsapp }}</a>
      </div>
    </form>
  </div>
</section>
