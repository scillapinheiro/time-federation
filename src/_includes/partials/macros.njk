{% macro icon(id, cls="") -%}
<svg class="icon {{ cls }}" aria-hidden="true" focusable="false"><use href="#{{ id }}"/></svg>
{%- endmacro %}

{% macro vhs(label, sub) -%}
<svg class="vhs" viewBox="0 0 238 136" aria-hidden="true" focusable="false">
  <use href="#vhs-body"/>
  <g transform="translate(65 76)"><use href="#hub" class="reel" width="28" height="28"/></g>
  <g transform="translate(145 76)"><use href="#hub" class="reel" width="28" height="28"/></g>
  <text x="19" y="41" fill="#140404" font-family="Orbitron, sans-serif" font-weight="700" font-size="14" letter-spacing=".5">{{ label }}</text>
  <text x="19" y="52" fill="#140404" fill-opacity=".75" font-family="'Share Tech Mono', monospace" font-size="7.5" letter-spacing="1">{{ sub }}</text>
</svg>
{%- endmacro %}

{% macro cassette(title) -%}
<svg class="cassette" viewBox="0 0 208 133" aria-hidden="true" focusable="false">
  <use href="#cassette-body"/>
  <g transform="translate(66 59)"><use href="#hub" class="reel" width="18" height="18"/></g>
  <g transform="translate(124 59)"><use href="#hub" class="reel" width="18" height="18"/></g>
  <text class="cassette__title" x="21" y="40" fill="#140404" font-family="Orbitron, sans-serif" font-weight="700" font-size="10" letter-spacing=".4">{{ title | upper }}</text>
  <text x="21" y="51" fill="#140404" fill-opacity=".7" font-family="'Share Tech Mono', monospace" font-size="6.5" letter-spacing="1">TIME FEDERATION</text>
</svg>
{%- endmacro %}

{% macro sectionHead(title, sub) -%}
<header class="section-head" data-reveal>
  <h2 class="section-title">{{ title }}</h2>
  {% if sub %}<p class="section-sub">{{ sub }}</p>{% endif %}
</header>
{%- endmacro %}
