{%- set p = store.product -%}
<section class="section store" id="store" aria-labelledby="store-title" data-store>
  <div class="container store__grid">
    <div class="store__info" data-reveal>
      <h2 class="section-title" id="store-title">{{ s.store.title }}</h2>
      <p class="section-sub">{{ s.store.subtitle }}</p>
      <div class="store__product">
        <p class="kicker">{{ p.kicker | t(lang) | upper }}</p>
        <h3 class="store__name">{{ p.name | upper }}</h3>
        <p class="store__desc">{{ p.description | t(lang) }}</p>
        <a class="btn btn--primary btn--block" href="{{ p.shopifyUrl or '#' }}"{% if p.shopifyUrl %} target="_blank" rel="noopener"{% endif %}>{{ s.store.buy }}</a>
        <p class="store__note">{{ s.store.note }}</p>
      </div>
    </div>
    <div class="store__media" data-reveal>
      <figure class="store__main">
        <img src="{{ p.photos[0].src }}" alt="{{ p.photos[0].alt | t(lang) }}" loading="lazy" decoding="async" data-store-main class="crop-{{ p.photos[0].crop }}"{% if p.photos[0].position %} style="object-position: {{ p.photos[0].position }}"{% endif %}>
      </figure>
      <ul class="store__thumbs">
        {% for ph in p.photos %}{% if not loop.first %}
        <li><button type="button" aria-label="{{ s.store.photo }}: {{ ph.alt | t(lang) }}" data-store-thumb data-src="{{ ph.src }}" data-crop="{{ ph.crop }}" data-alt="{{ ph.alt | t(lang) }}">
          <img src="{{ ph.srcSm }}" alt="" loading="lazy" class="crop-{{ ph.crop }}">
        </button></li>
        {% endif %}{% endfor %}
      </ul>
    </div>
  </div>
</section>
